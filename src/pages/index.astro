---
import Base from '../layouts/Base.astro';
import Dashboard from '../components/Dashboard.astro';
import HeroAscii from '../components/HeroAscii.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import LinkItem from '../components/LinkItem.astro';
import DitherScript from '../components/DitherScript.astro';
import { getProjects, getPosts, getLinks, url } from '../lib/site';
import { getShots } from '../lib/inspiration';

const projects = (await getProjects()).slice(0, 6);
const posts = (await getPosts()).slice(0, 4);
const links = (await getLinks()).slice(0, 4);
const shots = await getShots(4);
---
<Base title="Arik — Home">
  <section class="hero">
    <div class="hero-intro">
      <HeroAscii />
<pre class="banner" role="img" aria-label="Liber A.">██╗     ██╗██████╗ ███████╗██████╗    █████╗
██║     ██║██╔══██╗██╔════╝██╔══██╗  ██╔══██╗
██║     ██║██████╔╝█████╗  ██████╔╝  ███████║
██║     ██║██╔══██╗██╔══╝  ██╔══██╗  ██╔══██║
███████╗██║██████╔╝███████╗██║  ██║  ██║  ██║██╗
╚══════╝╚═╝╚═════╝ ╚══════╝╚═╝  ╚═╝  ╚═╝  ╚═╝╚═╝</pre>
      <div class="hero-copy">
        <h1>A public notebook of what I'm building, reading and thinking through — software engineering, AI, hardware and science.</h1>
      </div>
    </div>
    <Dashboard />
  </section>

  <div class="hatch-band" aria-hidden="true"></div>

  <section id="projects" class="rule-strong">
    <SectionHead num="01" path="~/projects" href="/projects/" linkLabel="All projects" />
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <div class="hatch-band" aria-hidden="true"></div>

  <section id="writing" class="rule-strong">
    <SectionHead num="02" path="~/writing" href="/writing/" linkLabel="All posts" />
    {posts.length ? posts.map((p) => <PostRow post={p} />) : <p class="empty">No posts yet.</p>}
  </section>

  <div class="hatch-band" aria-hidden="true"></div>

  <section id="reading" class="rule-strong">
    <SectionHead num="03" path="~/reading" href="/reading/" linkLabel="All links" />
    {links.map((l) => <LinkItem link={l} />)}
  </section>

  {shots.length > 0 && <>
    <div class="hatch-band" aria-hidden="true"></div>

    <section id="inspiration" class="rule-strong">
      <SectionHead num="04" path="~/inspiration" href="/inspiration/" linkLabel="All images" />
      <div class="strip">
        {shots.map((s) => (
          <a href={url('/inspiration/')} aria-label="Inspiration board">
            <div class="dither" data-dither={s.thumb.src}><img class="placeholder-img" src={s.thumb.src} alt="" loading="lazy" /></div>
          </a>
        ))}
      </div>
    </section>
    <DitherScript />
  </>}
</Base>
