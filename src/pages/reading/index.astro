---
import Base from '../../layouts/Base.astro';
import LinkItem from '../../components/LinkItem.astro';
import { getLinks } from '../../lib/site';
import { READING_TAGS } from '../../content.config';
const links = await getLinks();
const n = links.length;
---
<Base title="Arik — Reading" path={[{ label: 'reading' }]} footerRuled>
  <section class="intro soft">
    <div class="prompt"><span>arik@site</span>:~$ ls reading/</div>
    <h1>Links worth keeping.</h1>
    <p>Articles, books, podcasts and videos. Some come with a note.</p>
  </section>

  <div class="toolbar">
    <div class="filters" role="group" aria-label="Filter by tag">
      <button type="button" class="filter" data-tag="" aria-pressed="true">*</button>
      {READING_TAGS.map((t) => <button type="button" class="filter" data-tag={t} aria-pressed="false">{t}</button>)}
    </div>
    <div class="search">
      <label for="grep">grep</label>
      <input id="grep" type="search" placeholder="search links…" autocomplete="off" />
    </div>
  </div>
  <div class="count" aria-live="polite" data-count>{n} {n === 1 ? 'item' : 'items'}</div>

  <div data-links>
    {links.map((l) => <LinkItem link={l} full />)}
  </div>
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
  const input = document.querySelector<HTMLInputElement>('#grep')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-links] > [data-tag]')];

  const params = new URLSearchParams(location.search);
  let tag = params.get('tag') ?? '';
  if (!buttons.some((b) => b.dataset.tag === tag)) tag = '';
  input.value = params.get('q') ?? '';

  function apply() {
    const q = input.value.trim();
    const ql = q.toLowerCase();
    let n = 0;
    for (const el of items) {
      const show = (!tag || el.dataset.tag === tag) && (!ql || el.dataset.search!.includes(ql));
      el.hidden = !show;
      if (show) n++;
    }
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
    count.textContent = `${n} ${n === 1 ? 'item' : 'items'}` + (q ? ` matching "${q}"` : '');

    const u = new URL(location.href);
    tag ? u.searchParams.set('tag', tag) : u.searchParams.delete('tag');
    q ? u.searchParams.set('q', q) : u.searchParams.delete('q');
    history.replaceState(null, '', u);
  }

  buttons.forEach((b) => b.addEventListener('click', () => { tag = b.dataset.tag ?? ''; apply(); }));
  input.addEventListener('input', apply);
  apply();
</script>
