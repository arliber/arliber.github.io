---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import { url } from '../lib/site';

interface Props {
  title: string;
  dek: string;
  /** Title-bar path, e.g. [{ label: 'writing', href: '/writing/' }, { label: 'post.md' }] */
  path: { label: string; href?: string }[];
  /** Breadcrumb parts after the section link; `draft` renders in signal colour. */
  crumbs: { section: { label: string; href: string }; parts: string[]; draft?: boolean };
  meta: { k: string; v: string; href?: string; chip?: string }[];
  headings: MarkdownHeading[];
  related: { label: string; title: string; href: string }[];
  editPath: string;
}
const { title, dek, path, crumbs, meta, headings, related, editPath } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const BAR = 20;
---
<Base title={`Arik — ${title}`} description={dek} path={path} editPath={editPath}>
  <section class="article-head">
    <div class="crumbs">
      <a href={url(crumbs.section.href)}>{crumbs.section.label}</a>
      {crumbs.parts.map((p) => <> ／ {p}</>)}
      {crumbs.draft && <> ／ <span class="draft">Draft</span></>}
    </div>
    <h1>{title}</h1>
    <p class="dek">{dek}</p>
  </section>

  <div class="meta">
    {meta.map((m) => (
      <div>
        <span class="meta-k">{m.k}</span>
        {m.chip
          ? <span class="meta-v"><span class={`chip chip-${m.chip}`}>{m.v}</span></span>
          : m.href
            ? <a class="meta-v link" href={url(m.href)}>{m.v}</a>
            : <span class="meta-v">{m.v}</span>}
      </div>
    ))}
  </div>

  <div class="article-body">
    <aside class="sidebar">
      <div class="sidebar-sticky">
        {toc.length > 0 && (
          <div class="toc">
            <span class="toc-label">TREE</span>
            <nav aria-label="Contents">
              {toc.map((h, i) => <a href={`#${h.slug}`} aria-current={i === 0 ? 'true' : undefined}>└ {h.text}</a>)}
            </nav>
          </div>
        )}
        <div class="progress" aria-hidden="true">
          <span class="progress-bar" data-bar><span class="on"></span><span class="off">{'░'.repeat(BAR)}</span></span>
          <span class="progress-label"><span data-pct>0</span>% · PRESS ↑ / ↓ TO SCROLL</span>
        </div>
      </div>
    </aside>

    <article class="article-main">
      <div class="prose" data-prose>
        <slot />
      </div>
    </article>
  </div>

  {related.length > 0 && (
    <section class="rule-strong">
      <div class="related-head"><h2><span>── </span>Related</h2></div>
      <div class="related-list">
        {related.map((r) => (
          <a class="related-row" href={url(r.href)}>
            <span class="post-date">{r.label}</span>
            <span class="post-title">{r.title}</span>
            <span class="arrow">→</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  // Reading progress + current-section highlight.
  const prose = document.querySelector<HTMLElement>('[data-prose]')!;
  const on = document.querySelector<HTMLElement>('[data-bar] .on')!;
  const off = document.querySelector<HTMLElement>('[data-bar] .off')!;
  const pct = document.querySelector<HTMLElement>('[data-pct]')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Contents"] a')];
  const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  const BAR = 20;

  function update() {
    const r = prose.getBoundingClientRect();
    const span = r.height - innerHeight;
    const p = span <= 0 ? (r.top < innerHeight ? 1 : 0) : Math.min(1, Math.max(0, -r.top / span));
    const n = Math.round(p * BAR);
    on.textContent = '▓'.repeat(n);
    off.textContent = '░'.repeat(BAR - n);
    pct.textContent = String(Math.round(p * 100));

    let cur = 0;
    heads.forEach((h, i) => { if (h && h.getBoundingClientRect().top < innerHeight * 0.3) cur = i; });
    links.forEach((a, i) => (i === cur ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  }
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  update();

  // Code copy buttons.
  document.querySelectorAll<HTMLButtonElement>('.prose .copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.closest('.code')?.querySelector('pre')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = 'COPIED';
        setTimeout(() => (btn.textContent = 'COPY'), 1500);
      } catch {}
    });
  });
</script>
