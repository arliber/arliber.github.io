---
import type { CollectionEntry } from 'astro:content';
import { domainOf } from '../lib/site';
import Note from './Note.astro';
import TypeIcon from './TypeIcon.astro';
interface Props { link: CollectionEntry<'reading'>; full?: boolean }
const { link, full = false } = Astro.props;
const { url, type, title, description, tag, note } = link.data;
const domain = domainOf(url);
const anchor = { class: 'link-a', href: url, rel: 'noopener' };
---
{full ? (
  <div
    class="link-item lg"
    data-tag={tag}
    data-search={[title, description, domain, type, note ?? ''].join(' ').toLowerCase()}
  >
    <TypeIcon type={type} />
    <div class="link-body">
      <div class="link-top">
        <a {...anchor}><span class="link-title">{title}</span><span class="domain">{domain} ↗</span></a>
        <span class="link-tag">#{tag}</span>
      </div>
      <span class="link-desc">{description}</span>
      {note && <Note text={note} />}
    </div>
  </div>
) : (
  <div class="link-item">
    <TypeIcon type={type} />
    <div class="link-body">
      <a {...anchor}><span class="link-title">{title}</span><span class="domain">{domain} ↗</span></a>
      <span class="link-desc">{description}</span>
      {note && <Note text={note} />}
    </div>
  </div>
)}
